# Doxyfile for lintel
# Version: see LINTEL_VERSION in CMakeLists.txt (single source of truth)
# Cannot be derived automatically by this file alone without CMake; keep in sync.

PROJECT_NAME           = "lintel"
PROJECT_NUMBER         = "0.1.0"
OUTPUT_DIRECTORY       = build/doxygen
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = NO

# Input
INPUT                  = src/include/lintel
RECURSIVE              = YES
EXCLUDE_PATTERNS       =
EXCLUDE_SYMBOLS        =
EXAMPLE_PATH           =
IMAGE_PATH             =

# Build
# Graphviz is deliberately not used: it is not installable without root in the
# local dev container, and with WARN_AS_ERROR a missing "dot" aborts the run.
# Set to YES (and install graphviz locally + in CI) to get inheritance graphs.
HAVE_DOT               = NO
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_PACKAGE        = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
HIDE_FRIEND_COMPOUNDS  = NO
HIDE_IN_BODY_DOCS      = NO
CASE_SENSE_NAMES       = YES
SORT_MEMBER_DOCS       = YES

# Output formats
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
GENERATE_XML           = NO
GENERATE_MAN           = NO
GENERATE_DOCSET        = NO
GENERATE_HTMLHELP      = NO
GENERATE_CHI           = NO
GENERATE_RTF           = NO

# Warnings
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = YES
# Gate: documentation warnings fail the build. Baseline is zero warnings
# (all 13 warnings found in the first run were fixed in the headers).
WARN_AS_ERROR          = YES

# Other
QUIET                  = NO
