# Template for the local runtime configuration. Copy it once and adjust:
#
#   cp .env.example .env
#
# The resulting .env is git-ignored (see .gitignore) and must never be
# committed. It is loaded by scripts/run-example.sh, which exports every
# variable before starting the selected example.

# Directory that contains bootstrap.xml / bootstrap_worker.xml (and certs/,
# database/). Defaults to <repo>/cfg when unset.
CONFIG_DIRECTORY=/absolute/path/to/repo/cfg

# Bootstrap XML basename without ".xml". "main" uses "bootstrap"; a manually
# started worker uses "bootstrap_worker" (run-example.sh selects it for you).
BOOTSTRAP_CONFIG_NAME=bootstrap

# Initial admin user. When ADMIN_PASSWORD is set, the user is created on first
# start against the default database connection. Leave it empty to skip the
# admin bootstrap.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<change-me>
