<!-- General configuration of application -->
<Configuration>
    <!-- Process Configuration for Application -->
    <Processes>
        <!-- worker processes share memory + event bus with main but never
             touch the database; config selects their DB-free bootstrap.
             Relative process names are resolved against the configuration
             directory (CONFIG_DIRECTORY, default <repo>/cfg), so "../bin/worker"
             points to <repo>/bin/worker in a checkout and to /workspace/bin/worker
             in the docker "app" service. -->
        <Process name="../bin/worker" args="" autoRestart="true"
                 maxRestarts="-1" config="bootstrap_worker"/>
        <Process name="../bin/worker" args="" autoRestart="true"
                 maxRestarts="-1" config="bootstrap_worker"/>
    </Processes>

    <!-- Logging Configuration for Application -->
    <Loggers>
        <!-- path to logger directory; a leading "~" is expanded to $HOME
             (EnvironmentConfiguration::Home), missing directories are created
             because create_sub_dirs="true" -->
        <Path path="~/log/cpp-base-library" create_sub_dirs="true"/>
        <!-- Special template for logger -->
        <Logger process_name=".*" level="info" async="false">
            <!-- <LoggerSink type="ConsoleSink" level="trace"/> -->
            <!-- <LoggerSink type="DailyFileSink" level="debug" time="02:30"/> -->
            <LoggerSink type="RotatingFileSink" level="trace" size="5MB" max_files="10"/>
            <!-- <LoggerSink type="TcpSink" level="debug" pattern='{"timestamp":"%Y-%m-%dT%H:%M:%S.%fZ", "logger":"%n", "@severity":"%l", "file":"%s", "line":"%#", "message":"%v"}' connection="localhost" port="1234" /> -->
            <!-- <LoggerSink type="SysLogSink" level="error" pattern="..." id="ident"/> -->
        </Logger>
    </Loggers>

    <!-- Message Queue Configuration -->
    <MessageQueues>
        <MessageQueue process_name="main" name="history" max_messages="1000" remove_on_shutdown="false"/>
    </MessageQueues>

    <!-- History Service Configuration: explicitly activated and owned by the
         main process. Only the process whose name matches process_name
         creates the HistoryService; all other processes never start it. -->
    <HistoryServices>
        <HistoryService process_name="main" queue="history" max_messages="1000"/>
    </HistoryServices>

    <!-- Database Connections Configuration -->
    <DatabaseConnections>
	    <!--<DatabaseConnection name="DEFAULT_PSQL" user_name="example_user" password="${ADMIN_PASSWORD}" connection="127.0.0.1"
	    database_name="temp" type="PostgreSQL"/>--><!-- NOTE: Das alte Passwort steht in der Git-Historie und muss rotiert werden. ${ADMIN_PASSWORD} durch echtes Passwort ersetzen. -->
        <DatabaseConnection name="DEFAULT_SQLITE" connection="~/temp.db" type="SQLite" default="true"/>
    </DatabaseConnections>

    <!-- Shared Memory Segments Configuration -->
    <SharedMemorySegments>
        <Path path="~/dev/shm"/>
        <SharedMemorySegment name="shm_property" size="5MB" auto_extend_size="2MB" max_size="100MB"/>
        <SharedMemorySegment name="shm_test" size="5MB" auto_extend_size="2MB" max_size="50MB"/>
        <SharedMemorySegment name="shm_eventbus" size="8MB" auto_extend_size="2MB" max_size="50MB"/>
    </SharedMemorySegments>

    <!-- Event Bus Configuration -->
    <EventBuses>
        <EventBus name="main" segment="shm_eventbus" bus_capacity="128"
                  subscriber_capacity="128" max_topics="8" max_subscribers="8"/>
    </EventBuses>

    <!-- Http Server / Client Configuration -->
    <HttpHost>
        <!--
        TLS: relative cert_path/key_path are resolved against the config
        directory (cfg/). Self-signed test certificates live in cfg/certs/.
        <Server host="0.0.0.0" port="8080"
                cert_path="certs/server.crt" key_path="certs/server.key"
                require_tls="true"
                trusted_proxies="10.0.0.0/8, 192.168.1.5"/>
        require_tls: refuse to start without TLS cert/key (production)
        trusted_proxies: IPs/CIDRs whose X-Forwarded-For header is honored
        -->
        <Server host="0.0.0.0" port="8080" cert_path="certs/server.crt"
                key_path="certs/server.key" require_tls="true"/>
        <Client host="localhost" port="8080" cert_path="certs/server.crt"
                key_path="certs/server.key" ca_cert_path="certs/server.crt"
                connection_timeout="1000"/>
    </HttpHost>

    <!-- Property Configurations -->
    <PropertyRepositories>
        <PropertyRepository type="FILE_REPOSITORY" mutable="false" shadow="false"/>
        <PropertyRepository type="DATABASE_REPOSITORY" mutable="true" shadow="false"/>
        <PropertyRepository type="SHM_REPOSITORY" mutable="true" shadow="false"/>
    </PropertyRepositories>
    <Properties>
        <Property name="numberOfThreads" type="int32_t" value="2" process="main" class="SchedulerService"
                  instance="__DEFAULT"/>
    </Properties>
</Configuration>
