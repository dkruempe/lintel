<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE log4j:configuration SYSTEM "log4j.dtd">

<log4j:configuration debug="false" xmlns:log4j="http://jakarta.apache.org/log4j/">

    <appender name="common_file" class="log4cxx.FileAppender">
        <layout class="org.apache.log4j.PatternLayout">
            <param name="ConversionPattern" value="[%d{yyyy-MM-dd HH:mm:ss}|T%t|%-5p|%C::%M(%L)]: %m -- %l%n"/>
        </layout>
        <param name="File" value="template.log"/>
        <param name="Append" value="true"/>
    </appender>

    <appender name="console" class="log4cxx.ConsoleAppender">
        <layout class="org.apache.log4j.PatternLayout">
            <param name="ConversionPattern" value="[%d{yyyy-MM-dd HH:mm:ss}|T%t|%-5p|%C::%M(%L)]: %m -- %l%n"/>
        </layout>
    </appender>

    <appender name="socket" class="log4cxx.JsonSocketAppender">
        <param name="Application" value="YourApplication"/>
        <layout class="org.apache.log4j.json.JsonLayout">
            <param name="properties" value="true"/>
            <param name="locationInfo" value="true"/>
        </layout>
        <param name="Port" value="4560"/>
        <param name="RemoteHost" value="127.0.0.1"/>
        <param name="ReconnectionDelay" value="10"/>
    </appender>

    <root>
        <priority value="all"/>
        <appender-ref ref="common_file"/>
        <appender-ref ref="console"/>
        <appender-ref ref="socket"/>
    </root>

</log4j:configuration>
