<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE log4j:configuration SYSTEM "log4j.dtd">

<log4j:configuration debug="false" xmlns:log4j="http://jakarta.apache.org/log4j/">

    <appender name="common_file" class="log4cxx.FileAppender">
        <layout class="org.apache.log4j.PatternLayout">
			<param name="ConversionPattern" value="[%d{yyyy-MM-dd HH:mm:ss}|T%t|%-5p|%C::%M(%L)]: %m -- %l%n"/>
        </layout>
		<param name="File" value="/Users/dkruempe/CLionProjects/Logging/log/logger_example.log" />
		<param name="Append" value="true" />
    </appender>

	<appender name="console" class="log4cxx.ConsoleAppender">
		<layout class="org.apache.log4j.PatternLayout">
			<param name="ConversionPattern" value="[%d{yyyy-MM-dd HH:mm:ss}|T%t|%-5p|%C::%M(%L)]: %m -- %l%n"/>
		</layout>
	</appender>

	<root>
		<priority value="all" />
		<appender-ref ref="common_file" />
		<appender-ref ref="console" />
	</root>

</log4j:configuration>
