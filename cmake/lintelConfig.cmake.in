@PACKAGE_INIT@

# Package configuration for base_library.
#
# Important for relocation: no build-machine path appears here. Everything is resolved
# relative to ${CMAKE_CURRENT_LIST_DIR} resp. ${PACKAGE_PREFIX_DIR}, so the package works
# in any prefix after a `cmake --install`.

include(CMakeFindDependencyMacro)

# These dependencies appear as imported targets in the interface of
# lintel::base_library (target_link_libraries(... PUBLIC ...) in src/CMakeLists.txt)
# and must therefore be found here. Changes to the link list there belong in this list.
#
# Prerequisite is that the consumer resolves them with the same options as the recipe
# does (fmt/spdlog header_only, cpp-httplib with_openssl) - see conanfile.txt.
# magic_enum and rapidjson are linked via the Conan targets magic_enum::magic_enum and
# rapidjson; a consumer that provides them differently has to supply the names.
find_dependency(fmt)
find_dependency(tinyxml2)
find_dependency(PostgreSQL)
find_dependency(SQLite3)
find_dependency(Threads)
find_dependency(OpenSSL)
find_dependency(httplib)
find_dependency(date)
find_dependency(spdlog)
find_dependency(magic_enum)
find_dependency(RapidJSON)
find_dependency(Boost 1.75.0)

# Hypodermic is vendored (external/Hypodermic) and installed into the same prefix,
# but ships only Hypodermic_targets.cmake and no config file. Since the base_library
# export references lintel::Hypodermic, the targets file has to be loaded before the
# base_library targets, otherwise the export reports "The following imported targets are referenced,
# but are missing". The path via ../Hypodermic covers CMAKE_INSTALL_LIBDIR, the second
# candidate covers the hard-wired lib/cmake of the vendored export.
set(_base_library_hypodermic_targets "")
foreach(_candidate
        "${CMAKE_CURRENT_LIST_DIR}/../Hypodermic/Hypodermic_targets.cmake"
        "${PACKAGE_PREFIX_DIR}/lib/cmake/Hypodermic/Hypodermic_targets.cmake"
        "${PACKAGE_PREFIX_DIR}/${CMAKE_INSTALL_LIBDIR}/cmake/Hypodermic/Hypodermic_targets.cmake")
    if(EXISTS "${_candidate}")
        set(_base_library_hypodermic_targets "${_candidate}")
        break()
    endif()
endforeach()
if(_base_library_hypodermic_targets)
    include("${_base_library_hypodermic_targets}")
else()
    # No vendored export in the prefix - then Hypodermic has to be findable elsewhere.
    find_dependency(Hypodermic)
endif()
unset(_candidate)
unset(_base_library_hypodermic_targets)

include("${CMAKE_CURRENT_LIST_DIR}/base_libraryTargets.cmake")

check_required_components(base_library)
